# Copy this file to .env.local and fill in the production-ready values.

# Admin gate (server-only — never expose in client code)
ADMIN_GATE_EMAIL=
ADMIN_GATE_PASSWORD=
ADMIN_GATE_2FA_SECRET=

# AACA autonomous agent server (separate from Next.js — default port 3100)
AACA_PORT=3100
AACA_SERVICE_URL=http://127.0.0.1:3100
AACA_ALLOW_REDIS_FAILURE=true
# Cloud agents run inside Next.js (default). Set false only to force standalone AACA server.
AACA_CLOUD_MODE=true
# AACA_REQUIRE_LOCAL_SERVER=true
# Mastermind: auto-route agent phrases (default ON when deployed; set false to disable)
# AACA_AUTO_DELEGATE=false
CRON_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
WHATSAPP_DEFAULT_NUMBER=
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_ADDRESS=
PRIMARY_DOMAIN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
MASTER_COMPANY_ID=00000000-0000-0000-0000-000000000001
BRAND_NAME=
BRAND_NAME_AR=
FREE_HOOK_OFFER=
DEFAULT_LOCALE=ar-EG
TIMEZONE=Africa/Cairo
BOOKING_MODE=enabled
BOOKING_TIMEZONE=Africa/Cairo
BOOKING_WORKING_HOURS=Sat-Thu 10:00-19:00
BOOKING_SLOT_DURATION=30
STOCK_IMAGE_PROVIDER=pexels
STOCK_IMAGE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RATE_LIMIT_DISABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BROWSER_WORKSPACE_VIEWER_URL=
BROWSER_WORKSPACE_HEALTHCHECK_URL=
BROWSER_WORKSPACE_LABEL=Self-Hosted Browser
REMOTE_BROWSER_BASE_URL=
REMOTE_BROWSER_HEALTHCHECK_URL=
REMOTE_BROWSER_VNC_PASSWORD=
REMOTE_BROWSER_LABEL=OCI XFCE Browser
